SKILL_ID = "core.echo"
SKILL_VERSION = "0.1.0"


def describe():
    return {
        "id": SKILL_ID,
        "version": SKILL_VERSION,
        "input_type": "text",
        "output_type": "text",
        "examples": [
            "echo hello",
            "repeat this text",
            "say this back"
        ]
    }


def can_handle(input_data):
    text = str(input_data).strip().lower()

    return (
        text.startswith("echo ")
        or text.startswith("repeat ")
        or text.startswith("say ")
    )


def can_train():
    return False


def needs_training():
    return False


def train():
    return None


def predict(input_data):
    text = str(input_data).strip()

    for prefix in ["echo ", "repeat ", "say "]:
        if text.lower().startswith(prefix):
            return text[len(prefix):]

    return text


def teach(input_data, expected_output):
    return None

def configure(config: dict):
    return None


def forget(input_data, expected_output=None):
    return False


def training_examples():
    return [
        {
            "input": "echo hello",
            "output": "hello"
        },
        {
            "input": "repeat this text",
            "output": "this text"
        },
        {
            "input": "say this back",
            "output": "this back"
        }
    ]


def export_data():
    return {
        "examples": training_examples()
    }


